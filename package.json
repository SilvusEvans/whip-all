{
  "name": "whipall",
  "version": "1.2.0",
  "productName": "Whip-All",
  "description": "Nudge slow tools into gear (a.k.a. Whip-All)",
  "license": "MIT",
  "author": {
    "name": "Harvesbit",
    "email": "SilvusEvans@users.noreply.github.com"
  },
  "main": "main.js",
  "bin": {
    "whipall": "bin/whipall.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilvusEvans/whip-all.git"
  },
  "bugs": {
    "url": "https://github.com/SilvusEvans/whip-all/issues"
  },
  "homepage": "https://github.com/SilvusEvans/whip-all#readme",
  "files": [
    "main.js",
    "macro-worker.js",
    "preload.js",
    "overlay.html",
    "settings.html",
    "sounds",
    "icon",
    "bin/whipall.js",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.harvesbit.whipall",
    "productName": "Whip-All",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    }
  }
}
